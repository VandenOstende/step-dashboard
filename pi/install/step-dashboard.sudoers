# Wat de service met verhoogde rechten mag doen. Eén regel, geen wildcards,
# geen shell.
#
# Installeren met:  sudo install -m 0440 step-dashboard.sudoers /etc/sudoers.d/step-dashboard
# Controleren met:  sudo visudo -cf /etc/sudoers.d/step-dashboard

# Bijwerken vanaf GitHub. Exact dit commando, zonder jokertekens: step-update
# leest de repository en de tak zelf uit config.json, dus er hoeven geen
# argumenten door de sudo-regel heen.
pi ALL=(root) NOPASSWD: /usr/bin/systemd-run --unit=step-selfupdate --collect --quiet /usr/local/sbin/step-update
